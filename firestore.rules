// الصق ده في Firebase ← Firestore Database ← Rules ← Publish
// (مفيش Storage خلاص: الصور بتتخزن جوه Firestore نفسه)
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // الأدمن = أي حساب ليه مستند في مجموعة admins (اسم المستند = الـ UID)
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /admins/{uid}     { allow read: if request.auth != null && request.auth.uid == uid; }

    // الموقع بيقرا الأقسام والمنتجات والإعدادات، والأدمن بس هو اللي يعدّل
    match /products/{id}    { allow read: if true; allow write: if isAdmin(); }
    match /categories/{id}  { allow read: if true; allow write: if isAdmin(); }
    match /settings/{id}    { allow read: if true; allow write: if isAdmin(); }

    // الفروع: الموقع بيقراها (العميل يختار فرعه + رقم واتساب الفرع)، والأدمن يعدّلها
    match /branches/{id}    { allow read: if true; allow write: if isAdmin(); }

    // العميل يقرا بياناته بس، والأدمن يشوف الكل
    match /users/{uid} {
      allow create: if request.auth != null && request.auth.uid == uid;
      allow read:   if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow update, delete: if isAdmin();
    }

    // العميل يعمل طلب باسمه بس.
    // القراءة عامة عشان صفحة "تتبع الطلب" تدور برقم الطلب بدون تسجيل دخول.
    match /orders/{id} {
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid
                    && request.resource.data.status == 'جديدة';
      allow read:   if true;
      allow update, delete: if isAdmin();
    }

    // أي زائر يبعت رسالة، والأدمن بس يقراها
    match /messages/{id}    { allow create: if true; allow read, update, delete: if isAdmin(); }
  }
}
